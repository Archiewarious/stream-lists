{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "extension",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "extension",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "worker",
        "run",
        "dev:ext"
      ],
      "port": 8787,
      "url": "http://127.0.0.1:8787"
    },
    {
      "name": "extension-twitch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "extension",
        "run",
        "dev:twitch"
      ],
      "port": 8080,
      "url": "https://localhost:8080"
    }
  ]
}
